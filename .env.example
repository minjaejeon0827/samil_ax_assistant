# 백엔드
API_KEYS=change-this-key
ALLOWED_ORIGINS=http://localhost:5173
REPO=memory            # memory | mysql
LLM_PROVIDER=offline   # offline | openai | anthropic
# LLM_TIMEOUT_S=8       # 호출 제한 시간(초). 넘기면 재시도 1회 후 근거 기반 대체문
# LLM_CONCURRENCY=16    # 여러 건을 동시에 분석할 때 동시 호출 수
# LLM_MAX_INFLIGHT=16   # 서버 전체 외부 LLM 동시 요청 상한 — 제공자의 동시 요청 한도에 맞추세요(v1.17)
# LLM_TPM=30000         # v1.22: 분당 토큰 한도(제공자 한도보다 조금 낮게). 0이면 끔
# LLM_TPM_WINDOW_S=60   # 토큰 한도 창(초)
# OCR_LANGS=kor+eng     # v1.22: 스캔 PDF 글자 인식 언어(tesseract)
# OCR_MAX_PAGES=20      # v1.23: 글자 인식할 최대 쪽수(넘으면 '앞 n쪽만 읽음' 표시)
# OCR_BUDGET_S=120      # v1.23: 글자 인식 전체 시간 한도(초)
# OCR_WORKERS=0         # v1.23: 동시에 인식할 쪽 수(0=CPU 수, 최대 4)
# LLM_TPM_SCOPE=server  # v1.23: shared면 같은 MySQL을 쓰는 서버들이 토큰 한도를 함께 셈
# LLM_TPM_HEADERS=1     # v1.24: LLM_TPM이 없으면 제공자 응답 헤더(남은 토큰)로 속도를 맞춤(0=끔)
# LLM_RATE_WAIT_S=30    # 사용량 한도(429)를 기다리는 최대 시간(초). 넘기면 그 건만 대체문(차단기는 열지 않음)
# ENRICH_DEBOUNCE_S=0.4 # 명령 뒤 AI 설명을 쓰기 전 잠깐 기다림(연달아 바뀐 조건을 한 번에)
# SHUTDOWN_DRAIN_S=8    # 정상 종료 때 쓰던 AI 설명을 마칠 때까지 기다리는 시간
# LLM_COOLDOWN_S=60     # LLM이 실패하면 이 시간 동안 부르지 않음(회로 차단)
# OPENAI_BASE_URL=      # OpenAI 호환 서버(사내 게이트웨이 등) 주소
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MYSQL_HOST=localhost
# MYSQL_USER=aurora
# MYSQL_PASSWORD=
# 프론트(선택: FastAPI 모드 켜기)
VITE_ENABLE_API=1
VITE_API_URL=http://localhost:8000
VITE_API_KEY=change-this-key

# MCP 원격 전송(streamable-http) — FastAPI(8000)와 다른 포트
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8765
# MCP_TOKEN=            # 외부 주소(0.0.0.0 등)로 열 때 필수 — 요청마다 Authorization: Bearer <MCP_TOKEN>

# 로그인 모드(외부 공개 배포 필수) — 역할은 로그인한 계정이 정한다
# AUTH_MODE=jwt
# JWT_SECRET=           # 32자 이상 무작위 값
# USERS=ceo.kang:<비밀번호>:GROUP_CEO;masil.han:<비밀번호>:MASIL_CEO
# (v1.8) 비밀번호 자리에 미리 만든 해시를 넣을 수 있습니다: cd backend && python -m app.api.auth hash
#        → USERS=ceo.kang:pbkdf2_sha256$100000$...$...:GROUP_CEO  (평문을 환경변수에 두지 않음)
# (v1.29) 계정마다 다른 비밀번호(10자 이상·영문·숫자·기호 중 두 종류)를 쓰세요. 평문·규칙 미달·여러 계정 공용이면 서버가 기동 때
#        '경고: USERS — …'를 남깁니다(값·아이디는 쓰지 않음). 로그인 화면·문서·번들에 계정이나 비밀번호를 적지 마세요(29차 AP-02).
# TOKEN_TTL_S=900
# MCP를 로그인 모드 서버에 붙일 때: DESK_USER=… DESK_PASSWORD=…

# ---- v1.9(9차 E2E) ----
# 요청 본문 한도(바이트). 넘으면 413. 가장 큰 정상 요청(메모 2,000자)도 10KB 미만입니다.
# MAX_BODY_BYTES=65536
# 로그인 모드: 활동 중이면 자동 연장, 처음 로그인부터 이 시간(초)이 지나면 다시 로그인
# SESSION_MAX_S=28800
# 프록시(AXHub 인그레스) 뒤에서는 인그레스 주소(또는 대역)를 적어야 감사·로그인 잠금에 실제 접속 주소가 남습니다.
# 적지 않으면 모든 사용자가 프록시 주소 하나로 보입니다. 컨테이너가 인그레스로만 노출될 때만 '*'를 쓰세요.
# FORWARDED_ALLOW_IPS=10.0.0.0/8

# ---- v1.11(11차 E2E) ----
# DB 잠금(백업 등)을 기다리는 최대 초. 넘으면 쓰기는 503 '변경된 내용 없음'으로 끝납니다.
# DB_LOCK_WAIT_S=4
# 응답 없는 DB를 기다리는 최대 초(읽기·쓰기)
# DB_TIMEOUT_S=15

# ---- v1.15(15차 E2E) ----
# 서버 여러 대(복제본·무중단 배포)는 REPO=mysql에서만 지원합니다. 명령은 DB 행 잠금으로 한 번에 하나씩 처리합니다.
# 다른 서버의 명령이 끝나기를 기다리는 최대 초(넘으면 503 '변경된 내용 없음')
# DB_CMD_WAIT_S=20

# ---- v1.21 다음 단계(PRD §15) ----
# 사내 SSO(OIDC, 인가 코드 + PKCE). 설정하면 로그인 창에 'OIDC_LABEL로 로그인' 버튼이 생깁니다(AUTH_MODE=jwt 필요).
# OIDC_ISSUER=https://login.example.com/realms/aurora
# OIDC_CLIENT_ID=aurora-desk
# OIDC_CLIENT_SECRET=...
# OIDC_REDIRECT_URI=https://desk.example.com/      # 화면 주소(IdP 앱 등록과 똑같이)
# OIDC_ROLE_CLAIM=aurora_role                       # 역할 클레임(값: GROUP_CEO 등)
# OIDC_GROUP_ROLES=grp-ceo:GROUP_CEO;grp-fin:FINANCE
# OIDC_LABEL=사내 SSO
# IdP 앱에 Back-Channel Logout URI로 https://desk.example.com/api/auth/oidc/backchannel 등록(v1.23)
# OIDC_POST_LOGOUT_URI=https://desk.example.com/  # v1.22: SSO 로그아웃 뒤 돌아올 주소(기본 OIDC_REDIRECT_URI, IdP 앱 등록과 똑같이)
# 전자결재·메신저 연동(웹훅). 기본 outbox(화면 발송함만, 모의)
# CHANNEL=webhook
# CHANNEL_SECRET=...                                # 보내는 웹훅 서명(HMAC-SHA256), 32자 이상 권장
# ESIGN_WEBHOOK_URL=https://esign.example.com/hooks/aurora
# MESSENGER_WEBHOOK_URL=https://chat.example.com/hooks/aurora
# ESIGN_SECRET=...                                  # 받는 콜백(POST /api/integrations/approval) 서명 검증 — 없으면 CHANNEL_SECRET
# ESIGN_USERS=kim.ceo:GROUP_CEO;han.masil:MASIL_CEO # 전자결재 결재자 아이디 → 역할
# PUBLIC_URL=https://desk.example.com               # 결재 요청에 넣을 링크


# ---- v1.25(25차 E2E) 운영 DB ----
# DB 연결을 풀에서 빌려 씀 — 쉬는 연결을 최대 몇 개까지 남길지(0이면 요청마다 새로 연결). 서버 수 × 이 값 < MySQL max_connections
# DB_POOL_SIZE=8
# 이만큼(초) 쉰 연결은 빌려주기 전에 살아 있는지 확인(DB 재시작·wait_timeout 대비)
# DB_POOL_PING_S=0      (v1.26: 기본 0 = 빌려줄 때마다 확인)
# 한 서버가 동시에 여는 연결 상한과, 상한에서 연결을 기다리는 최대 초(v1.26). 서버 수 × DB_POOL_MAX < max_connections
# DB_POOL_MAX=10
# DB_POOL_WAIT_S=5
# (v1.27) 이만큼(초)마다 감사 기록 머리값을 메신저로(0이면 끔). 서버 여러 대도 주기마다 한 번, 새 기록이 없으면 안 보냄
# AUDIT_ANCHOR_S=3600
# 감사 기록 보호 트리거·운영 보기(v_*)는 서버가 뜰 때 없으면 만듭니다. 권한이 없으면 /api/health의 db.guards가 False → 관리자 계정으로 schema.sql 적용
